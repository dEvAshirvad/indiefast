# Copy to .env. WEB_URL stays a URL because CORS needs the exact origin.
# Everything else is a host and a port. The call site builds a URL when it needs one.
#
# Local compose binds datastores to 127.0.0.1. VPS compose (docker-compose.vps.yml)
# publishes none. On that network set the hosts to the service names:
#   DATABASE_HOST=postgres  REDIS_HOST=redis  S3_HOST=minio  SMTP_HOST=mailpit

NODE_ENV=development
PORT=4000
APP_HOST=localhost
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=indiefast
DATABASE_PASSWORD=indiefast
DATABASE_NAME=indiefast

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=indiefast

S3_HOST=localhost
S3_PORT=9000
S3_ACCESS_KEY=indiefast
S3_SECRET_KEY=indiefastindiefast
S3_BUCKET=indiefast
S3_REGION=us-east-1

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# smtp talks to Mailhog and needs no user. ses and resend throw EMAIL_NOT_CONFIGURED until their keys are set.
EMAIL_PROVIDER=smtp
EMAIL_FROM="IndieFast <noreply@indiefast.local>"
# EMAIL_API_ENABLED defaults on in development and off otherwise. Set true or false to override.
RESEND_API_KEY=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=
# NEXT_PUBLIC_EMAIL_API_ENABLED=false
# Timeouts, the idempotency TTL, and the shutdown drain are constants in apps/api/src.
# They are the same on every machine. Env holds hosts, secrets, and flags.
AUTH_SECRET=dev-auth-secret-change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Viewers only. Not read by the API.
# Adminer http://127.0.0.1:8080  pgAdmin http://127.0.0.1:5050  RedisInsight http://127.0.0.1:5540
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=indiefast
